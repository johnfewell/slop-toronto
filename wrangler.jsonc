// Cloudflare: the site is static, served as a Worker's static assets from dist/ (node tools/build-site.mjs builds it,
// with dist/_headers). Deploy: node tools/build-site.mjs && npx wrangler@4 deploy
{
  "name": "slop-toronto",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" }
}

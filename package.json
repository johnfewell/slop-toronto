{
  "name": "slop-toronto",
  "private": true,
  "type": "module",
  "description": "Toronto in three.js WebGPU + TSL, on the engine of Slop New York by mrdoob",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "build": "npm run build:clouds && node tools/build-site.mjs",
    "test": "node --test tests/*.cjs tests/*.mjs",
    "capture": "node tools/capture.mjs",
    "build:water": "node tools/build-water.mjs",
    "build:clouds": "node tools/build-clouds.mjs"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "earcut": "3.2.4",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "shapefile": "0.6.6",
    "three": "0.186.1",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@takram/three-atmosphere": "https://github.com/johnfewell/three-geospatial/releases/download/fork-release-7/takram-three-atmosphere-0.19.1%2Bfork.7.tgz",
    "@takram/three-geospatial": "https://github.com/johnfewell/three-geospatial/releases/download/fork-release-7/takram-three-geospatial-0.9.1%2Bfork.7.tgz",
    "three-clouds-webgpu": "file:vendor/clouds/three-clouds-webgpu-0.1.0-alpha.6.tgz"
  },
  "overrides": {
    "@takram/three-atmosphere": "$@takram/three-atmosphere",
    "@takram/three-geospatial": "$@takram/three-geospatial"
  }
}

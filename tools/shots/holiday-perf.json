[
 {
  "name": "holiday-nps-tree",
  "mode": "person",
  "js": "(() => {const C=window.CITY,a=window.__CITY_APP;\nwindow.__hv=(from,at,fov=55)=>{a.cameraSystem.cinema=()=>({pos:from,look:at,fov});};\n\nwindow.__nps=()=>{const r=C.RINKS.records.find(q=>q.assetId==='43599'),rect=C.outlineRectangle(r.polygons[0].outer),site=C.rinkStats.sites.find(q=>q.assetId==='43599');return {rect,tree:[rect.x+rect.ax*(rect.length/2+11),rect.z+rect.az*(rect.length/2+11)],y:site?site.y:0.2};};\nconsole.log('[holiday-check] '+JSON.stringify(C.holidayStats));})();(()=>{const {rect,tree,y}=window.__nps(),dx=rect.x-tree[0],dz=rect.z-tree[1],L=Math.hypot(dx,dz),ux=dx/L,uz=dz/L;window.__hv([tree[0]+ux*30-uz*6,y+7,tree[1]+uz*30+ux*6],[tree[0],y+7,tree[1]],58);})()",
  "wait": 1800
 },
 {
  "name": "holiday-perf",

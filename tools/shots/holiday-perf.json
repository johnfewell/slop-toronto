  "js": "(()=>{const {rect,tree,y}=window.__nps(),px=-rect.az,pz=rect.ax;window.__hv([rect.x+px*38-rect.ax*6,y+14,rect.z+pz*38-rect.az*6],[(rect.x+tree[0])/2,y+5,(rect.z+tree[1])/2],62);})()",

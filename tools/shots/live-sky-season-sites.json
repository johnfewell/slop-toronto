  "js": "(()=>{{const min=document.body.classList.contains('hud-minimized');if(!min)document.getElementById('btn-toggle-hud').click();}const app=window.__CITY_APP,C=window.CITY;const view=(side,along,dist,height,fov)=>{const r=C.RINKS.records.find(q=>q.assetId==='43599'),site=C.rinkStats.sites.find(q=>q.assetId==='43599'),rect=C.outlineRectangle(r.polygons[0].outer),px=-rect.az,pz=rect.ax,d=(rect.width/2+rect.length*.35+14)*dist,x=rect.x+px*d*side+rect.ax*rect.length*along,z=rect.z+pz*d*side+rect.az*rect.length*along;app.teleportTo(rect.x+px*(rect.width/2+6),rect.z+pz*(rect.width/2+6),0);const pos=[x,site.y+18*height+rect.length*.25*height,z],look=[rect.x,site.y,rect.z];app.cameraSystem.cinema=()=>({pos,look,fov});};view(1,.2,1,1,55);const st=app.seasons.state(),R=C.rinkStats||{},P=C.patioStats||{};const out={siteDate:C.SITE_DATE,sites:st.sites,trees:{phase:st.phase,leaf:st.leaf},rinks:{season:R.season,forced:R.forced,nps:(R.sites||[]).filter(s=>s.assetId==='43599').map(s=>s.surface)},patios:{season:P.season,date:P.date,layout:P.layout||null,ms:P.ms??null,fingerprint:P.fingerprint||null,placed:P.placed},bikeDetours:C.bikeDetourStats,sky:{active:app.liveSky.state().active,clock:app.liveSky.state().clock}};console.log('[ride-check] season-sites '+JSON.stringify(out));return out;})()"

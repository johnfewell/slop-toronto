    "js": "(async()=>{const a=window.__CITY_APP,R=a.subwayRide;a.film.start(10);try{for(let i=0;i<140&&!R.canChase;i++)await a.film.step(25);if(!R.canChase)throw new Error('Did not reach open viaduct');for(let i=0;i<6;i++)await a.film.step(25);a.selectCamera('pov',true);await a.film.step(2);const c=a.cameraSystem.camera;console.log('[ride-check] seat '+JSON.stringify({car:R.car&&R.car.id,s:R.car&&Math.round(R.car.s),eye:R.entity.seatEye,yaw:R.entity.seatYaw,lookY:R.entity.seatLookY,aspect:+c.aspect.toFixed(3),fov:c.fov,mask:c.layers.mask,preset:a.cameraSystem.activePresetId}));}finally{a.film.stop();}})()"

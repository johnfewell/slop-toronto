    "name": "seat-castle-frank",
    "wait": 1000,
    "js": "(()=>{const a=window.__CITY_APP,R=a.subwayRide;if(!R.active)throw new Error('No subway ride');document.getElementById('locate-prompt').hidden=true;const c=a.cameraSystem.camera;console.log('[ride-check] seat '+JSON.stringify({car:R.car&&R.car.id,s:R.car&&Math.round(R.car.s),eye:R.entity.seatEye,yaw:R.entity.seatYaw,lookY:R.entity.seatLookY,aspect:+c.aspect.toFixed(3),fov:c.fov,mask:c.layers.mask,preset:a.cameraSystem.activePresetId}));})()"

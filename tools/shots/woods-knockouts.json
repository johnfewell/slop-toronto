  "js": "(()=>{const app=window.__CITY_APP;const T=app.scene.getObjectByName('Trees');const out={};T.children.forEach((m)=>{if(!m.visible||!m.count)return;const g=m.geometry;const tri=(g.index?g.index.count:g.attributes.position.count)/3;const k=m.name.replace(/^Trees_(ez-)?/,'').replace(/-(small|medium|large)/,'');out[k]=out[k]||{n:0,tri:0};out[k].n+=m.count;out[k].tri+=m.count*tri;});const i=app.renderer.info.render;return {levels:out,draws:i.drawCalls,triangles:i.triangles,net:app.qualityNet&&app.qualityNet.state?app.qualityNet.state():null};})()"
 },
